<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Proof of Registration · {@registration.tracking_number}</title>
    <style>
      :root {
        --ink: #1a2332;
        --muted: #5b6575;
        --line: #c9d0da;
        --accent: #0f4c81;
        --accent-soft: #e8f1f8;
        --paper: #f7f5f1;
        --white: #ffffff;
        --ok: #1f6b45;
      }

      * { box-sizing: border-box; }

      body {
        margin: 0;
        color: var(--ink);
        background: linear-gradient(180deg, #eef2f6 0%, var(--paper) 40%, #ebe7df 100%);
        font-family: "Source Serif 4", "Iowan Old Style", "Palatino Linotype", Palatino, Georgia, serif;
        -webkit-print-color-adjust: exact;
        print-color-adjust: exact;
      }

      .page {
        min-height: 100vh;
        padding: 2rem 1rem 3rem;
      }

      .toolbar {
        max-width: 820px;
        margin: 0 auto 1.25rem;
        display: flex;
        justify-content: flex-end;
        gap: 0.75rem;
      }

      .btn {
        appearance: none;
        border: 0;
        border-radius: 999px;
        padding: 0.7rem 1.2rem;
        font: 600 0.85rem/1 system-ui, -apple-system, Segoe UI, sans-serif;
        cursor: pointer;
        transition: transform 0.15s ease, background 0.15s ease;
      }

      .btn:active { transform: scale(0.98); }
      .btn-primary { background: var(--accent); color: white; }
      .btn-primary:hover { background: #0c3d68; }
      .btn-ghost { background: white; color: var(--ink); border: 1px solid var(--line); }

      .sheet {
        max-width: 820px;
        margin: 0 auto;
        background: var(--white);
        border: 1px solid var(--line);
        box-shadow: 0 18px 50px rgba(26, 35, 50, 0.08);
        position: relative;
        overflow: hidden;
      }

      .sheet::before {
        content: "";
        position: absolute;
        inset: 14px;
        border: 1px solid rgba(15, 76, 129, 0.28);
        pointer-events: none;
      }

      .sheet-inner {
        position: relative;
        padding: 2.5rem 2.25rem 2rem;
      }

      .brand {
        display: grid;
        grid-template-columns: 72px 1fr auto;
        gap: 1rem;
        align-items: center;
        padding-bottom: 1.25rem;
        border-bottom: 2px solid var(--accent);
      }

      .brand img {
        width: 72px;
        height: 72px;
        object-fit: contain;
      }

      .brand-text h1 {
        margin: 0;
        font-size: 1.15rem;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        color: var(--accent);
      }

      .brand-text p {
        margin: 0.25rem 0 0;
        color: var(--muted);
        font-size: 0.82rem;
        font-family: system-ui, -apple-system, Segoe UI, sans-serif;
      }

      .doc-mark {
        text-align: right;
        font-family: system-ui, -apple-system, Segoe UI, sans-serif;
      }

      .doc-mark .label {
        display: inline-block;
        padding: 0.35rem 0.7rem;
        background: var(--accent-soft);
        color: var(--accent);
        border: 1px solid rgba(15, 76, 129, 0.2);
        border-radius: 999px;
        font-size: 0.68rem;
        font-weight: 700;
        letter-spacing: 0.08em;
        text-transform: uppercase;
      }

      .doc-mark .ref {
        margin-top: 0.45rem;
        font-size: 0.75rem;
        color: var(--muted);
        font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
      }

      .title-block {
        text-align: center;
        padding: 1.75rem 0 1.5rem;
      }

      .title-block h2 {
        margin: 0;
        font-size: clamp(1.6rem, 3vw, 2.15rem);
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: var(--ink);
      }

      .title-block p {
        margin: 0.55rem auto 0;
        max-width: 34rem;
        color: var(--muted);
        font-size: 0.95rem;
        font-family: system-ui, -apple-system, Segoe UI, sans-serif;
        line-height: 1.45;
      }

      .status {
        margin-top: 0.9rem;
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        padding: 0.35rem 0.8rem;
        border-radius: 999px;
        background: #e8f6ee;
        color: var(--ok);
        font-family: system-ui, -apple-system, Segoe UI, sans-serif;
        font-size: 0.75rem;
        font-weight: 700;
        letter-spacing: 0.06em;
        text-transform: uppercase;
      }

      .grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 0.9rem 1.25rem;
        padding: 1.1rem;
        background: linear-gradient(180deg, #fbfaf8, #f3f1ec);
        border: 1px solid var(--line);
      }

      .field dt {
        margin: 0;
        font-family: system-ui, -apple-system, Segoe UI, sans-serif;
        font-size: 0.7rem;
        font-weight: 700;
        letter-spacing: 0.07em;
        text-transform: uppercase;
        color: var(--muted);
      }

      .field dd {
        margin: 0.28rem 0 0;
        font-size: 1rem;
        font-weight: 600;
        word-break: break-word;
      }

      .field dd.mono {
        font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
        font-size: 0.92rem;
        font-weight: 500;
      }

      .section {
        margin-top: 1.75rem;
      }

      .section h3 {
        margin: 0 0 0.75rem;
        font-family: system-ui, -apple-system, Segoe UI, sans-serif;
        font-size: 0.78rem;
        font-weight: 700;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--accent);
      }

      table {
        width: 100%;
        border-collapse: collapse;
        font-family: system-ui, -apple-system, Segoe UI, sans-serif;
        font-size: 0.9rem;
      }

      thead th {
        text-align: left;
        padding: 0.65rem 0.75rem;
        background: var(--accent);
        color: white;
        font-size: 0.72rem;
        letter-spacing: 0.06em;
        text-transform: uppercase;
      }

      tbody td {
        padding: 0.7rem 0.75rem;
        border-bottom: 1px solid var(--line);
        vertical-align: top;
      }

      tbody tr:nth-child(even) td { background: #faf9f7; }

      .code {
        font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
        font-size: 0.8rem;
        color: var(--accent);
        font-weight: 600;
      }

      .credits { text-align: right; white-space: nowrap; color: var(--muted); }
      .total-row td {
        font-weight: 700;
        background: var(--accent-soft) !important;
        border-bottom: 0;
      }

      .attest {
        margin-top: 1.75rem;
        padding: 1rem 1.1rem;
        border-left: 3px solid var(--accent);
        background: #f8fafc;
        font-family: system-ui, -apple-system, Segoe UI, sans-serif;
        font-size: 0.86rem;
        line-height: 1.55;
        color: var(--muted);
      }

      .signoff {
        margin-top: 2.25rem;
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 2rem;
        font-family: system-ui, -apple-system, Segoe UI, sans-serif;
      }

      .sign-line {
        border-top: 1px solid var(--ink);
        padding-top: 0.55rem;
        margin-top: 2.5rem;
      }

      .sign-line strong {
        display: block;
        font-size: 0.85rem;
      }

      .sign-line span {
        color: var(--muted);
        font-size: 0.75rem;
      }

      .footer {
        margin-top: 2rem;
        padding-top: 0.9rem;
        border-top: 1px solid var(--line);
        display: flex;
        justify-content: space-between;
        gap: 1rem;
        flex-wrap: wrap;
        font-family: system-ui, -apple-system, Segoe UI, sans-serif;
        font-size: 0.72rem;
        color: var(--muted);
      }

      .empty {
        padding: 1rem;
        border: 1px dashed var(--line);
        color: var(--muted);
        font-family: system-ui, -apple-system, Segoe UI, sans-serif;
        font-size: 0.9rem;
      }

      @media (max-width: 640px) {
        .brand { grid-template-columns: 56px 1fr; }
        .doc-mark { grid-column: 1 / -1; text-align: left; }
        .grid, .signoff { grid-template-columns: 1fr; }
        .sheet-inner { padding: 1.4rem 1.1rem 1.2rem; }
      }

      @media print {
        body { background: white; }
        .page { padding: 0; }
        .toolbar { display: none !important; }
        .sheet {
          max-width: none;
          border: 0;
          box-shadow: none;
        }
        .sheet::before { inset: 8px; }
      }
    </style>
  </head>
  <body>
    <div class="page">
      <div class="toolbar">
        <button type="button" class="btn btn-ghost" onclick="window.history.back()">Back</button>
        <button type="button" class="btn btn-primary" onclick="window.print()">
          Print / Save as PDF
        </button>
      </div>

      <article class="sheet" id="proof-of-registration">
        <div class="sheet-inner">
          <header class="brand">
            <img src={~p"/images/ccc_logo.png"} alt="Cavendish University Zambia" />
            <div class="brand-text">
              <h1>Cavendish University Zambia</h1>
              <p>Office of the Registrar · Student Registration Services</p>
            </div>
            <div class="doc-mark">
              <div class="label">Official Document</div>
              <div class="ref">{@registration.tracking_number}</div>
            </div>
          </header>

          <div class="title-block">
            <h2>Proof of Registration</h2>
            <p>
              This document confirms that the student named below has completed
              course registration and received final approval for the stated
              academic period.
            </p>
            <div class="status">Approved · Fully Registered</div>
          </div>

          <dl class="grid">
            <div class="field">
              <dt>Student Name</dt>
              <dd>{@registration.student_names}</dd>
            </div>
            <div class="field">
              <dt>Student Number</dt>
              <dd class="mono">{@registration.student_id}</dd>
            </div>
            <div class="field">
              <dt>Programme</dt>
              <dd>{programme(@registration)}</dd>
            </div>
            <div class="field">
              <dt>Academic Period</dt>
              <dd>{academic_period(@registration)}</dd>
            </div>
            <div class="field">
              <dt>Tracking Number</dt>
              <dd class="mono">{@registration.tracking_number}</dd>
            </div>
            <div class="field">
              <dt>Date of Approval</dt>
              <dd>{Calendar.strftime(@registration.updated_at, "%d %B %Y")}</dd>
            </div>
          </dl>

          <section class="section">
            <h3>Registered Courses</h3>
            <%= if selected_courses(@registration) == [] do %>
              <div class="empty">No course details were recorded for this registration.</div>
            <% else %>
              <table>
                <thead>
                  <tr>
                    <th style="width: 18%;">Code</th>
                    <th>Course Title</th>
                    <th style="width: 16%; text-align: right;">Credits</th>
                  </tr>
                </thead>
                <tbody>
                  <%= for course <- selected_courses(@registration) do %>
                    <tr>
                      <td class="code">{course_code(course)}</td>
                      <td>{course_name(course)}</td>
                      <td class="credits">{course_credits(course)}</td>
                    </tr>
                  <% end %>
                  <tr class="total-row">
                    <td colspan="2">Total Credit Hours</td>
                    <td class="credits">{total_credits(@registration)}</td>
                  </tr>
                </tbody>
              </table>
            <% end %>
          </section>

          <div class="attest">
            This Proof of Registration is system-generated by CUZ Core Connect
            following successful completion of the university registration workflow.
            Verify authenticity using the tracking number above at the campus
            registration portal.
          </div>

          <div class="signoff">
            <div>
              <div class="sign-line">
                <strong>Retention / Continuing Office</strong>
                <span>Final approval authority</span>
              </div>
            </div>
            <div>
              <div class="sign-line">
                <strong>System Verification</strong>
                <span>
                  Issued {Calendar.strftime(DateTime.utc_now(), "%d %B %Y · %H:%M UTC")}
                </span>
              </div>
            </div>
          </div>

          <footer class="footer">
            <span>CUZ Core Connect · Proof of Registration</span>
            <span>Document ID: {@registration.tracking_number}</span>
          </footer>
        </div>
      </article>
    </div>
  </body>
</html>
